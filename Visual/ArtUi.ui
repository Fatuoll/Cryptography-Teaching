           <property name="geometry">
            <rect>
             <x>0</x>
             <y>0</y>
             <width>221</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:9pt; font-weight:600;&quot;&gt;3. Shared Secret&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn3_nss">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>76</y>
             <width>441</width>
             <height>16</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Nika uses her private key &lt;span style=&quot; font-weight:600;&quot;&gt;n&lt;/span&gt; and Rik's public key &lt;span style=&quot; font-weight:600;&quot;&gt;R&lt;/span&gt;. &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;S = nR = n(rG) = nrG&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn3_att">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>140</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;An attacker can see: &lt;span style=&quot; font-weight:600;&quot;&gt;G&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;N&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;R&lt;/span&gt;. However, the attacker doesn't know the private keys &lt;span style=&quot; font-weight:600;&quot;&gt;n&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;r&lt;/span&gt;. To obtain the private keys from public keys, an attacker would have to solve a camputationally difficult problem related to the &lt;span style=&quot; font-weight:600;&quot;&gt;Elliptic Curve Discrete Logarithm Problem&lt;/span&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn3_rss">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>100</y>
             <width>441</width>
             <height>16</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Rik uses his private key &lt;span style=&quot; font-weight:600;&quot;&gt;r&lt;/span&gt; and Nika's public key &lt;span style=&quot; font-weight:600;&quot;&gt;N&lt;/span&gt;. &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;S = rN = r(nG) = rnG&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </widget>
        </widget>
