             <x>170</x>
             <y>90</y>
             <width>271</width>
             <height>16</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;where &lt;span style=&quot; font-weight:600;&quot;&gt;a&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;b&lt;/span&gt; are parameters of the curve.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn2_ff">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>150</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Cryptography typically uses a curve over a finite field: &lt;span style=&quot; font-weight:600;&quot;&gt;y&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:super;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;≡&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;x&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:super;&quot;&gt;3&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;+ax+b (mod p)&lt;/span&gt;. Here all operations are performed modulo the prime number &lt;span style=&quot; font-weight:600;&quot;&gt;p&lt;/span&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </widget>
        </widget>
