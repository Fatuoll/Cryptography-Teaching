          <widget class="QLabel" name="lbl_eeccmn3_p">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>26</y>
             <width>441</width>
             <height>16</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Point&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;  P = (x&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;, y&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;) &lt;/span&gt;belongs to the curve if&lt;span style=&quot; font-weight:600;&quot;&gt; y&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:super;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;=x&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:super;&quot;&gt;3&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;+ax&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;+b&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn3_pa">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>60</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Point Addition&lt;/span&gt;. If &lt;span style=&quot; font-weight:600;&quot;&gt;P &lt;/span&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-weight:600;&quot;&gt;ꞓ &lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;curve&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;Q &lt;/span&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-weight:600;&quot;&gt;ꞓ &lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;curve&lt;/span&gt;, then&lt;span style=&quot; font-weight:600;&quot;&gt; P + Q &lt;/span&gt;&lt;span style=&quot; font-family:'Calibri,sans-serif'; font-weight:600;&quot;&gt;ꞓ &lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;curve &lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;(this is not ordinary coordinate addition: &lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;(x&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;, y&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;) + (x&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;, y&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;) ≠ (x&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt; + x&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;, y&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt; + y&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic; vertical-align:sub;&quot;&gt;2&lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;)&lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;. The addition is performed according to the special rules of the elliptic curve)&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn3_pd">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>160</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Point Doubling&lt;/span&gt;.&lt;span style=&quot; font-weight:600;&quot;&gt; P + P = 2P&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;2P + 2P = 4P&lt;/span&gt;, ...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn3_pn">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>110</y>
             <width>421</width>
             <height>51</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Point Negation&lt;/span&gt;. For every point &lt;span style=&quot; font-weight:600;&quot;&gt;P=(x, y)&lt;/span&gt;, there is an opposite point &lt;span style=&quot; font-weight:600;&quot;&gt;-P=(x, -y)&lt;/span&gt;. (When working over a finite field, the coordinate is taken modulo p). The main property:&lt;span style=&quot; font-weight:600;&quot;&gt; P+(-P)=O&lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt; (where O is the special point at infinity. &lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;O is the identity element of the addition operation&lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;).&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn3_sm">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>200</y>
             <width>421</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Scalar Multiplication&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;kP=P+P+...+P&lt;/span&gt; (&lt;span style=&quot; font-weight:600;&quot;&gt;k&lt;/span&gt; times) (&lt;span style=&quot; font-weight:600;&quot;&gt;k&lt;/span&gt; is an &lt;span style=&quot; font-weight:600;&quot;&gt;interger&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;P&lt;/span&gt; is a &lt;span style=&quot; font-weight:600;&quot;&gt;point&lt;/span&gt; on the curve). This is one of the most important operation in ECC.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn3_fsm">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>240</y>
             <width>421</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Fast Scalar Multiplication&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;kP=P+P+...+P&lt;/span&gt; (&lt;span style=&quot; font-weight:600;&quot;&gt;k&lt;/span&gt; times) But for&lt;span style=&quot; font-weight:600;&quot;&gt; large k&lt;/span&gt;, this would be too &lt;span style=&quot; font-weight:600;&quot;&gt;slow&lt;/span&gt;. Therefore, fast algoritms such as &lt;span style=&quot; font-weight:600;&quot;&gt;double-and-add&lt;/span&gt; are used: &lt;span style=&quot; font-weight:600;&quot;&gt;P → 2P → 4P → 8P → 16P → ...&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </widget>
        </widget>
