            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;1. ECDH uses the mathematical principles of elliptic curves (ECC)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn1_cnss">
           <property name="geometry">
