          <widget class="QLabel" name="lbl_eecdhmn2_par">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>60</y>
             <width>441</width>
             <height>16</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Before using ECDH, both parties must use the &lt;span style=&quot; font-weight:600;&quot;&gt;same elliptic curve&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;its parameters&lt;/span&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_nr">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>30</y>
             <width>441</width>
             <height>21</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Let Nika wants to send a message to Rik.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_nprk">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>90</y>
             <width>441</width>
             <height>21</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Nika generates a random number&lt;/span&gt;: &lt;span style=&quot; font-weight:600;&quot;&gt;n&lt;/span&gt;. This is her &lt;span style=&quot; font-weight:600;&quot;&gt;private key&lt;/span&gt;. It must remain secret!&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_ke">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>220</y>
             <width>441</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Public key exchange&lt;/span&gt; (&lt;span style=&quot; font-weight:600;&quot;&gt;N → Rik&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;R → Nika&lt;/span&gt;). After the exchange: &lt;span style=&quot; font-weight:600;&quot;&gt;Nika&lt;/span&gt; knows &lt;span style=&quot; font-weight:600;&quot;&gt;n&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;N&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;R&lt;/span&gt; and &lt;span style=&quot; font-weight:600;&quot;&gt;Rik&lt;/span&gt; knows &lt;span style=&quot; font-weight:600;&quot;&gt;r&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;R&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;N&lt;/span&gt;. (Private keys &lt;span style=&quot; font-weight:600;&quot;&gt;n&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;r&lt;/span&gt; were &lt;span style=&quot; font-weight:600;&quot;&gt;never transmitted&lt;/span&gt;!)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_npbk">
           <property name="geometry">
            <rect>
             <x>30</x>
             <y>110</y>
             <width>411</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Nika calculate her &lt;span style=&quot; font-weight:600;&quot;&gt;public key&lt;/span&gt;: &lt;span style=&quot; font-weight:600;&quot;&gt;N = nG &lt;/span&gt;(where: &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;n - private key&lt;/span&gt;, &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;G - the common base point&lt;/span&gt;, &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;N - public key&lt;/span&gt;). Nika can send N to Rik.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_rprk">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>150</y>
             <width>441</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Rik independently generates a random number&lt;/span&gt;: &lt;span style=&quot; font-weight:600;&quot;&gt;r&lt;/span&gt;. This is his &lt;span style=&quot; font-weight:600;&quot;&gt;private key&lt;/span&gt;. It also must remain secret!&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn2_rpbk">
           <property name="geometry">
            <rect>
             <x>30</x>
             <y>180</y>
             <width>411</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Rik calculate his &lt;span style=&quot; font-weight:600;&quot;&gt;public key&lt;/span&gt;: &lt;span style=&quot; font-weight:600;&quot;&gt;R = rG &lt;/span&gt;(where: &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;r - private key&lt;/span&gt;, &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;G - the common base point&lt;/span&gt;, R&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt; - public key&lt;/span&gt;). Rik can send R to Nika.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </widget>
        </widget>
