          <widget class="QLabel" name="lbl_eeccmn4_prk">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>60</y>
             <width>441</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Private key&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;d &lt;/span&gt;is chosen from a valid range determined by the curve parameters. &lt;span style=&quot; font-weight:600;&quot;&gt;The private key must remain secret&lt;/span&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn4_pbk">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>100</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;Public key&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;Q=dG &lt;/span&gt;(where &lt;span style=&quot; font-weight:600;&quot;&gt;d - the private key&lt;/span&gt;,&lt;span style=&quot; font-weight:600;&quot;&gt; G - the base point&lt;/span&gt;, &lt;span style=&quot; font-weight:600;&quot;&gt;Q - the public key&lt;/span&gt;). Here &lt;span style=&quot; font-weight:600;&quot;&gt;dG&lt;/span&gt; means &lt;span style=&quot; font-weight:600;&quot;&gt;scalar multiplication of a point. &lt;/span&gt;The public key can be shared with other participants.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn4_owo">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>160</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600; text-decoration: underline;&quot;&gt;One-way operation in ECC&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;d, G → Q&lt;/span&gt; can be performed &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;efficiently&lt;/span&gt;. &lt;span style=&quot; font-weight:600;&quot;&gt;Q, G → d&lt;/span&gt; is camputationally &lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;extremely difficult&lt;/span&gt;. This problem is called the &lt;span style=&quot; font-weight:600;&quot;&gt;Elliptic Curve Descrete Logarithm Problem&lt;/span&gt;. Therefore, &lt;span style=&quot; font-weight:600;&quot;&gt;Q&lt;/span&gt; can be safely &lt;span style=&quot; font-weight:600;&quot;&gt;shared&lt;/span&gt; without revealing d.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eeccmn4_ar1">
