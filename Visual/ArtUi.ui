            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:9pt; font-weight:600;&quot;&gt;4. KDF&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn4_abkdf">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>60</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The ECDH result &lt;span style=&quot; font-weight:600;&quot;&gt;S = nrG&lt;/span&gt; is a shared secret represented as a &lt;span style=&quot; font-weight:600;&quot;&gt;point on an elliptic curve&lt;/span&gt;. It's generally &lt;span style=&quot; font-weight:600;&quot;&gt;not used&lt;/span&gt; directly &lt;span style=&quot; font-weight:600;&quot;&gt;as an AES key&lt;/span&gt;. Instead, the shared secret is passed through a&lt;span style=&quot; font-weight:600;&quot;&gt; Key Derivation Function&lt;/span&gt; (KDF).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn4_ndea">
           <property name="geometry">
            <rect>
             <x>0</x>
             <y>141</y>
             <width>441</width>
             <height>20</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;ECDH is not a data encryption algorithm! &lt;/span&gt;Its purpose is to establish a shared secret.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
          <widget class="QLabel" name="lbl_eecdhmn4_skdfaes">
