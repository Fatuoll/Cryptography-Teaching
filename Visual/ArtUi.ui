             <y>90</y>
             <width>441</width>
             <height>41</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;ECDH - (Elliptic Curve Deffie-Hellman)&lt;/span&gt; is a cryptographic protocol that allows two participants to obtain &lt;span style=&quot; font-weight:600;&quot;&gt;one shared secret&lt;/span&gt; without transmitting it directly.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
