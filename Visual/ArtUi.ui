             <width>411</width>
             <height>31</height>
            </rect>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;2. The main purpose of &lt;span style=&quot; font-weight:600;&quot;&gt;ECDH&lt;/span&gt; is it to&lt;span style=&quot; font-weight:600;&quot;&gt; solve the problem&lt;/span&gt;:&lt;span style=&quot; font-style:italic;&quot;&gt; how can two participants obtain a shared secret key if they  &lt;/span&gt;&lt;span style=&quot; font-weight:600; font-style:italic;&quot;&gt;cannot simply send &lt;/span&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;the key to each other&lt;/span&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
